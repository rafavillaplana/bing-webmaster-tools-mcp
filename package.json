{
  "name": "bing-webmaster-tools-mcp",
  "version": "1.0.0",
  "description": "Local MCP server for Bing Webmaster Tools: query your Bing search performance, crawl, links and keywords from Claude Desktop, Claude Code or any MCP client.",
  "type": "module",
  "license": "MIT",
  "author": "Rafa Villaplana (https://rafavillaplana.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafavillaplana/bing-webmaster-tools-mcp.git"
  },
  "homepage": "https://github.com/rafavillaplana/bing-webmaster-tools-mcp#readme",
  "bugs": {
    "url": "https://github.com/rafavillaplana/bing-webmaster-tools-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "claude",
    "claude-desktop",
    "bing",
    "bing-webmaster-tools",
    "seo"
  ],
  "bin": {
    "bing-webmaster-tools-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.es.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "test:e2e": "npm run build && node test/e2e/run.mjs",
    "pack": "npm run build && node scripts/pack-mcpb.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  }
}
